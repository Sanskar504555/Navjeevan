{
  "name": "navjeevan-emr",
  "productName": "Navjeevan Fertility EMR",
  "version": "1.0.0",
  "description": "Offline desktop patient management system for Navjeevan Fertility & IVF Center",
  "main": "src/main.js",
  "author": "Solvinz",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run build:renderer",
    "start": "npm run build:renderer && electron .",
    "build:js": "esbuild renderer/src/index.jsx --bundle --minify --jsx=automatic --outfile=renderer/bundle.js --loader:.js=jsx",
    "build:css": "tailwindcss -i ./renderer/src/input.css -o ./renderer/styles.css --minify",
    "build:renderer": "npm run build:js && npm run build:css",
    "test:core": "npm rebuild better-sqlite3 && node test/test-core.js && npm run postinstall",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:dir": "npm run build:renderer && electron-builder --win nsis --dir"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.solvinz.navjeevanemr",
    "productName": "Navjeevan Fertility EMR",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Navjeevan EMR"
    }
  }
}