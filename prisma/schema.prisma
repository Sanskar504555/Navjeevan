datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCTOR
  LAB_TECH
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReportStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           String       @id @default(uuid())
  fullName     String       @map("full_name")
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         Role         @default(STAFF)
  reports      TestReport[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model Patient {
  id        String       @id @default(uuid())
  patientId String       @unique @map("patient_id")
  fullName  String       @map("full_name")
  age       Int?
  gender    Gender?
  phone     String?
  email     String?
  // Full patient intake record from the EMR registration form (history,
  // exam findings, hormone panels, husband's investigations, treatment
  // cycles, etc). The form captures far more than the columns above, so
  // the complete object is kept here as-is; the columns above exist only
  // for indexing/search. See api/patients for read/write shape.
  data      Json         @default("{}")
  reports   TestReport[]
  prescriptions Prescription[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("patients")
}

model Prescription {
  id        String   @id @default(uuid())
  // Client-generated id from PrescriptionModal (rx.id) — kept as the lookup
  // key for the same reason Patient.patientId is: the frontend never has to
  // remap ids after a save.
  rxId      String   @unique @map("rx_id")
  // References Patient.patientId (the client-generated id), not Patient.id.
  patientId String   @map("patient_id")
  patient   Patient  @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  // Full prescription object (date, doctor, advice, medicines[]) as produced
  // by PrescriptionModal in renderer/src/App.jsx, stored as-is.
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prescriptions")
}

model TestReport {
  id        String       @id @default(uuid())
  patientId String       @map("patient_id")
  createdBy String       @map("created_by")
  testType  String       @map("test_type")
  results   Json         @default("{}")
  status    ReportStatus @default(PENDING)
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creator   User         @relation(fields: [createdBy], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("test_reports")
}

model SyncLog {
  id           String   @id @default(uuid())
  deviceId     String   @map("device_id")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  @@map("sync_logs")
}